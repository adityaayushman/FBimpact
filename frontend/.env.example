# The deployed backend. Set this in Vercel > Project > Settings > Environment Variables.
#
# Next inlines NEXT_PUBLIC_* at BUILD time, so changing this needs a redeploy,
# not a restart. With no value set the UI says "no backend configured" rather
# than failing against localhost from an HTTPS page.
NEXT_PUBLIC_API_URL=https://fbimpact-api.onrender.com

# For local development, copy this file to .env.local and point it at your own
# uvicorn instead:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
