# OPTIONAL. The frontend defaults to the deployed backend at
# https://fbimpact-api.onrender.com, so a fresh deploy works with no
# configuration at all.
#
# Set this only to point at a different backend - typically your own uvicorn
# during development. Next inlines NEXT_PUBLIC_* at BUILD time, so changing it
# requires a rebuild, not just a restart.
#
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
